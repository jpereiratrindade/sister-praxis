{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/schemas/praxis/decision.schema.json",
  "title": "SisTer-Praxis Governed Decision",
  "type": "object",
  "required": ["id", "assessment_refs", "alternatives", "selected", "rationale", "authority", "successor_state"],
  "properties": {
    "id": {"type": "string"},
    "assessment_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "selected": {"type": "string"},
    "rationale": {"type": "string"},
    "authority": {"type": "string"},
    "conditions": {"type": "array"},
    "successor_state": {"type": "string"}
  },
  "additionalProperties": false
}
