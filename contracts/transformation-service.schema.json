{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/schemas/praxis/transformation-service.schema.json",
  "title": "SisTer-Praxis Transformation Service",
  "type": "object",
  "required": ["id", "owner", "kind", "contract_ref", "implementation_ref", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": ["analysis", "derivation", "aggregation", "comparison", "evaluation", "projection", "conversion"]
    },
    "contract_ref": {"type": "string", "minLength": 1},
    "implementation_ref": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"}
  },
  "additionalProperties": false
}
